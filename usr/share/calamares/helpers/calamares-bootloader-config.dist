#!/bin/bash

set -x

live_sources_param_list=( -o Dir::Etc::sourceparts='/usr/share/live-config-dist/sources.list.d' )

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

echo "Running bootloader-config..."

if [ -d /sys/firmware/efi/efivars ]; then
    echo " * Installing grub-efi (uefi)..."
    chroot $CHROOT apt-get-noninteractive "${live_sources_param_list[@]}" update
    chroot $CHROOT apt-get-noninteractive "${live_sources_param_list[@]}" -y install grub-efi
elif [ "$(dpkg --print-architecture)" = 'amd64' ]; then
    echo " * install grub... (bios)"
    chroot $CHROOT apt-get-noninteractive "${live_sources_param_list[@]}" update
    ## Seed grub-pc/install_devices BEFORE installing grub-pc. Unseeded, its
    ## postinst leaves it not fully configured and finish-grub-setup's
    ## dpkg-reconfigure aborts. Probe /boot, not /: on an encrypted install /
    ## is the LUKS mapper device, which grub-install cannot embed into, while
    ## /boot resolves to the physical disk either way. /boot/grub does not
    ## exist yet. grub-probe comes from grub-common, already in the target.
    ## Runs late enough: Calamares (calamares-settings-debian settings.conf) runs every
    ## 'show' page, incl. 'partition', before any 'exec' job; in 'exec', bootloader-config
    ## comes after 'partition' (applies the layout), 'mount' (mounts the target, incl. a
    ## separate /boot) and 'unpackfs'. Observed in a BIOS install log: this helper ran as
    ## job 17/30, and the following 'bootloader' job ran grub-install on /dev/sda.
    if ! chroot "${CHROOT}" test -d /boot; then
        printf '%s\n' "ERROR: ${CHROOT}/boot missing; cannot determine the grub-pc install device." >&2
        exit 1
    fi
    grub_pc_install_devices="$(chroot "${CHROOT}" grub-probe --target=disk /boot)"
    if [ -z "${grub_pc_install_devices}" ]; then
        printf '%s\n' "ERROR: grub-probe found no disk for ${CHROOT}/boot; refusing to seed an empty grub-pc/install_devices." >&2
        exit 1
    fi
    ## grub-probe can output multiple disks.
    grub_pc_install_devices="${grub_pc_install_devices//$'\n'/, }"
    printf '%s\n' "grub-pc grub-pc/install_devices multiselect ${grub_pc_install_devices}" | chroot "${CHROOT}" debconf-set-selections
    chroot $CHROOT apt-get-noninteractive "${live_sources_param_list[@]}" -y install grub-pc
fi

# Re-enable os-prober:
sed -i "s/#GRUB_DISABLE_OS_PROBER=false/# OS_PROBER re-enabled by Debian Calamares installation:\nGRUB_DISABLE_OS_PROBER=false/g" $CHROOT/etc/default/grub
chroot $CHROOT /usr/sbin/update-grub
