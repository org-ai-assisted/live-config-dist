#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Provision a persistent overlay for a live ISO, in the booted USB's OWN
## trailing free space (default) or on a second disk. NON-INTERACTIVE: driven by
## mandatory flags, no prompts. The only interactive step is the passphrase
## prompt systemd-cryptsetup shows at BOOT (for a password-encrypted overlay).
##
## Engine: imperative sgdisk (GPT) + cryptsetup. sgdisk CREATES fresh partitions
## (and, with --force, deletes the old overlay partitions first and recreates
## them -- a true reformat); cryptsetup luksFormat encrypts with a deterministic
## header UUID. For the booted stick, `sgdisk -e` first relocates the isohybrid
## backup-GPT header to the true device end so the trailing free space is usable.

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
   exit 1
fi

if was_executed "${BASH_SOURCE[0]}"; then
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C
fi

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/as_root.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/as_root.sh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/parse_opt.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/parse_opt.sh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/log_run_die.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/log_run_die.sh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/password_strength.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/password_strength.sh

persistence_label='persistence'
## Unencrypted boot area for the (future) updatable-boot feature: the signed grub
## can read ext4 but NOT LUKS, so an encrypted overlay keeps its updatable
## kernel+initrd+grub.cfg here. Carved only when encrypting; empty until used.
boot_label='persistbootx'
boot_size='512M'
overlay_dir='live/overlay'
overlay_workdir='live/ovlwork'

## GPT partition type GUIDs (Discoverable Partitions Spec / LUKS convention).
persist_type_guid_plain='0FC63DAF-8483-4772-8E79-3D69D8477DE4'
persist_type_guid_luks='CA7D7CCB-63ED-4C53-861C-1742536059CC'
boot_type_guid='BC13C2FF-59E6-4262-A352-B275FD6F7172'

## HARDCODED default, also in derivative-maker dm-raw-to-iso: the ISO's LUKS
## persistence boot entry pins rd.luks.uuid to this so dracut finds+unlocks the
## overlay. Override with --luks-uuid (then adjust the ISO / GRUB cmdline to match).
##
## TODO-HUMAN-DEVELOPER-ONLY: Regenerate this UUID securely.
default_luks_uuid='40e273d7-4e63-4459-b16f-ba3df4374905'

## Set by provision_persistence_fs while a LUKS mapping is open, so the EXIT trap
## can close it on any failure.
open_mapper=''

usage() {
   printf '%s\n' "Usage: ${0##*/} --encrypt true|false [OPTIONS]

Provision a persistent overlay for a live ISO. Non-interactive.

Required:
      --encrypt true|false   encrypt the overlay (LUKS2 + Argon2id) or not.
                             No default; must be given explicitly.

When --encrypt true:
      --key-type <list>      comma-separated unlock methods. A 'password' or
                             'keyfile' PRIMARY is required; 'tpm' may be added
                             (tpm alone is refused -- it binds the stick to one
                             machine and leaves no portable unlock). e.g.
                             --key-type password or --key-type password,tpm.
      --passphrase-file <f>  file with the passphrase (or '-' for stdin).
                             Required when --key-type includes 'password'.
                             NEVER pass a passphrase on argv.
      --keyfile <f>          non-empty key file to enroll. Required when
                             --key-type includes 'keyfile'.
      --allow-weak-passphrase  skip the passphrase-strength gate (pwscore).
      --luks-uuid <uuid>     LUKS2 header UUID (default: a fixed value the ISO
                             recognizes). Change only if you adjust the ISO to
                             match.

Target:
      --target usb-freespace|disk   where to create the overlay.
                             usb-freespace (default): the booted USB's own
                             trailing free space. disk: a whole second disk.
  -d, --device <dev>         whole-disk device for --target disk (e.g. /dev/sdb).

Other:
  -f, --filesystem <fs>      overlay filesystem: ext4 or btrfs (default: ext4).
      --force                reformat even if the target already holds a
                             persistence or LUKS volume (deletes + recreates it).
  -h, --help                 show this help.
"
   exit "${1}"
}

## usb-freespace: resolve the whole disk the live medium booted from.
resolve_boot_disk() {
   local live_src parent

   boot_disk=''
   ## The dracut dmsquash-live medium is mounted here; its backing partition's
   ## parent is the stick.
   live_src="$(findmnt --noheadings --output SOURCE --target /run/initramfs/live 2>/dev/null || true)"
   if [ -z "${live_src}" ]; then
      live_src="$(findmnt --noheadings --output SOURCE --target /run/rootfsbase 2>/dev/null || true)"
   fi
   if [ -z "${live_src}" ]; then
      return 0
   fi
   parent="$(lsblk --noheadings --output PKNAME --paths "${live_src}" 2>/dev/null | head --lines 1 || true)"
   if [ -n "${parent}" ]; then
      boot_disk="${parent}"
   fi
}

## For --target disk: whole, unmounted, unheld disks only; the boot disk is
## excluded by the caller.
build_candidate_disk_list() {
   local lsblk_line lsblk_disk_name lsblk_mounts_str sysfs_block_dir dev_is_held

   candidate_disk_list=()
   while read -r lsblk_line; do
      dev_is_held='false'
      read -r lsblk_disk_name lsblk_mounts_str <<< "${lsblk_line}"
      if ! [[ "${lsblk_disk_name}" \
         =~ ^(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$ ]]; then
         continue
      fi
      if [ -n "${lsblk_mounts_str}" ]; then
         continue
      fi
      for sysfs_block_dir in "/sys/class/block/${lsblk_disk_name}"*; do
         if ! [ -d "${sysfs_block_dir}" ]; then
            continue
         fi
         if [ -n "$(find "${sysfs_block_dir}/holders" -mindepth 1 -maxdepth 1 2>&1)" ]; then
            dev_is_held='true'
            break
         fi
      done
      if [ "${dev_is_held}" = 'true' ]; then
         continue
      fi
      candidate_disk_list+=( "${lsblk_disk_name}" )
   done < <(lsblk --raw --noheadings --output=NAME,MOUNTPOINTS)
}

## Parse the comma-separated --key-type into has_password/has_keyfile/has_tpm.
parse_key_type() {
   local csv token

   has_password='false'
   has_keyfile='false'
   has_tpm='false'
   csv="${1}"
   ## Pure-bash comma split (a here-string would append a newline to the last
   ## token).
   while [ -n "${csv}" ]; do
      token="${csv%%,*}"
      if [ "${token}" = "${csv}" ]; then
         csv=''
      else
         csv="${csv#*,}"
      fi
      case "${token}" in
         password)
            has_password='true'
            ;;
         keyfile)
            has_keyfile='true'
            ;;
         tpm)
            has_tpm='true'
            ;;
         "")
            true "INFO: empty token (trailing/double comma), ignored."
            ;;
         *)
            die 1 "--key-type: unknown method '${token}' (allowed: password, keyfile, tpm)."
            ;;
      esac
   done
}

## Decide the PRIMARY unlock (the slot luksFormat creates) and which extra slots
## to enroll. A password or keyfile primary is mandatory; tpm is additive only.
plan_encryption() {
   primary_key_kind='none'
   enroll_keyfile_extra='false'
   enroll_tpm='false'

   if [ "${has_password}" = 'true' ]; then
      primary_key_kind='password'
   elif [ "${has_keyfile}" = 'true' ]; then
      primary_key_kind='keyfile'
   fi

   if [ "${primary_key_kind}" = 'none' ]; then
      die 1 "--key-type tpm requires a 'password' or 'keyfile' primary too (a portable overlay cannot be TPM-only)."
   fi
   if [ "${has_password}" = 'true' ] && [ "${has_keyfile}" = 'true' ]; then
      enroll_keyfile_extra='true'
   fi
   if [ "${has_tpm}" = 'true' ]; then
      enroll_tpm='true'
   fi
}

## Read the passphrase (file or stdin) WITHOUT it ever reaching argv.
read_passphrase() {
   passphrase=''
   if [ "${passphrase_file}" = '-' ]; then
      IFS= read -r passphrase || true
   else
      IFS= read -r passphrase < "${passphrase_file}" || true
   fi
}

## The key material that luksFormat / luksAddKey / cryptenroll / luksOpen unlock
## with: the passphrase (RAM-only tmpfs file) or the keyfile path.
make_primary_key_file() {
   primary_key_file=''
   if [ "${primary_key_kind}" = 'password' ]; then
      primary_key_file="$(mktemp -p /dev/shm persistence-setup-key.XXXXXX)"
      printf '%s' "${passphrase}" > "${primary_key_file}"
   elif [ "${primary_key_kind}" = 'keyfile' ]; then
      primary_key_file="${keyfile}"
   fi
}

## --force: delete the existing overlay partitions so they are recreated fresh.
delete_overlay_partitions() {
   local -a nums
   local pn plabel

   nums=()
   ## Ensure partition labels are populated (a preceding sgdisk re-read may be
   ## in flight).
   udevadm settle || true
   while read -r pn plabel; do
      case "${plabel}" in
         "${persistence_label}"|"${boot_label}")
            if [ -n "${pn}" ]; then
               nums+=( "${pn}" )
            fi
            ;;
      esac
   done < <(lsblk --noheadings --raw --output PARTN,PARTLABEL "${device}")

   if [ "${#nums[@]}" -eq 0 ]; then
      return 0
   fi
   ## Delete highest-numbered first so earlier numbers stay valid.
   while read -r pn; do
      log_run notice sgdisk -d "${pn}" "${device}"
   done < <(printf '%s\n' "${nums[@]}" | sort --numeric-sort --reverse)
   partprobe "${device}" 2>/dev/null || true
   udevadm settle || true
}

## Create the GPT partitions imperatively: boot (unencrypted, when encrypting)
## then the persistence overlay filling the remaining free space.
## Sorted list of the device's partition node paths (one per line).
list_partitions() {
   ## --raw: plain names; the default tree output prefixes child NAMEs with
   ## tree-drawing characters (|- / `-) that corrupt the device path.
   lsblk --noheadings --raw --paths --output NAME,TYPE "${device}" \
      | awk '$2 == "part" { print $1 }' | sort
}

## Create one GPT partition and set `new_partition` to the node that APPEARED
## (diff before/after), so a pre-existing same-labelled partition can never be
## taken for the new one. Sets a global (not echo) so log output on stdout
## cannot pollute the captured value.
create_one_partition() {
   local before after
   new_partition=''
   before="$(list_partitions)"
   log_run notice sgdisk "$@" "${device}"
   partprobe "${device}" 2>/dev/null || true
   udevadm settle || true
   after="$(list_partitions)"
   new_partition="$(comm -13 <(printf '%s\n' "${before}") <(printf '%s\n' "${after}") | head --lines 1)"
}

## Create the boot (when encrypting) + persistence partitions, capturing their
## exact new device nodes into boot_partition / persistence_partition.
create_partitions() {
   boot_partition=''
   persistence_partition=''

   if [ "${encrypt}" = 'true' ]; then
      create_one_partition -n "0:0:+${boot_size}" -t "0:${boot_type_guid}" -c "0:${boot_label}"
      boot_partition="${new_partition}"
      if [ -z "${boot_partition}" ]; then
         die 1 "could not identify the new '${boot_label}' partition."
      fi
   fi
   create_one_partition -n '0:0:0' -t "0:${persist_type_guid}" -c "0:${persistence_label}"
   persistence_partition="${new_partition}"
   if [ -z "${persistence_partition}" ]; then
      die 1 "could not identify the new '${persistence_label}' partition."
   fi
}

## Seed the OverlayFS upper + work dirs on an already-formatted filesystem.
seed_overlay_dirs() {
   local fs_device mount_dir

   fs_device="${1}"
   mount_dir="$(mktemp --directory)"
   log_run notice mount -- "${fs_device}" "${mount_dir}"
   log_run notice mkdir --parents -- "${mount_dir}/${overlay_dir}" "${mount_dir}/${overlay_workdir}"
   log_run notice umount -- "${mount_dir}"
   rmdir -- "${mount_dir}"
}

## Format + seed the persistence partition: LUKS2 (if encrypting) then the
## filesystem, or the plain filesystem.
provision_persistence_fs() {
   local part fs_device

   part="${1}"
   log_run notice wipefs --all -- "${part}"

   if [ "${encrypt}" = 'true' ]; then
      log notice "Formatting LUKS2 (Argon2id) on '${part}'."
      cryptsetup luksFormat --type luks2 --pbkdf argon2id --uuid "${luks_uuid}" \
         --batch-mode --key-file "${primary_key_file}" -- "${part}"
      if [ "${enroll_keyfile_extra}" = 'true' ]; then
         log_run notice cryptsetup luksAddKey --batch-mode \
            --key-file "${primary_key_file}" -- "${part}" "${keyfile}"
      fi
      if [ "${enroll_tpm}" = 'true' ]; then
         log_run notice systemd-cryptenroll --unlock-key-file="${primary_key_file}" \
            --tpm2-device=auto "${part}"
      fi
      open_mapper="persistence_setup_${$}"
      cryptsetup luksOpen --key-file "${primary_key_file}" -- "${part}" "${open_mapper}"
      fs_device="/dev/mapper/${open_mapper}"
   else
      fs_device="${part}"
   fi

   "mkfs.${filesystem}" -L "${persistence_label}" "${fs_device}"
   seed_overlay_dirs "${fs_device}"

   if [ -n "${open_mapper}" ]; then
      log_run notice cryptsetup luksClose "${open_mapper}"
      open_mapper=''
   fi
}

persistence_setup_cleanup() {
   if [ -n "${open_mapper:-}" ] && [ -b "/dev/mapper/${open_mapper}" ]; then
      cryptsetup luksClose "${open_mapper}" || true
   fi
   if [ -n "${primary_key_file:-}" ] && [ "${primary_key_kind:-}" = 'password' ] \
      && [ -e "${primary_key_file}" ]; then
      shred --remove -- "${primary_key_file}" 2>/dev/null || safe-rm --force -- "${primary_key_file}"
   fi
}

main() {
   local device_opt existing_state candidate_disk cmdline_file \
      device_type boot_partition persistence_partition keyfile_size \
      col_fstype col_partlabel col_label

   ## Defaults + unset sentinels.
   target='usb-freespace'
   device_opt=''
   encrypt=''
   key_type=''
   passphrase_file=''
   keyfile=''
   filesystem='ext4'
   allow_weak_passphrase='false'
   force='false'
   luks_uuid="${default_luks_uuid}"

   while true; do
      begin_optparse "${1:-}" "${2:-}" || break
      case "${opt}" in
         target)
            get_arg
            target="${arg}"
            ;;
         d|device)
            get_arg
            device_opt="${arg}"
            ;;
         encrypt)
            get_arg
            encrypt="${arg}"
            ;;
         key-type)
            get_arg
            key_type="${arg}"
            ;;
         passphrase-file)
            get_arg
            passphrase_file="${arg}"
            ;;
         keyfile)
            get_arg
            keyfile="${arg}"
            ;;
         luks-uuid)
            get_arg
            luks_uuid="${arg}"
            ;;
         f|filesystem)
            get_arg
            filesystem="${arg}"
            ;;
         allow-weak-passphrase)
            allow_weak_passphrase='true'
            ;;
         force)
            force='true'
            ;;
         h|help)
            usage 0
            ;;
         "")
            break
            ;;
         *)
            die 2 "Invalid option: '${opt_orig}'"
            ;;
      esac
      shift "${shift_n:-1}"
   done

   ## --- validate (no device is touched in this block) ---------------------
   range_arg target "${target}" usb-freespace disk
   range_arg filesystem "${filesystem}" ext4 btrfs
   if [ -z "${encrypt}" ]; then
      die 1 "--encrypt is mandatory (true or false); refusing to guess."
   fi
   range_arg encrypt "${encrypt}" true false

   has_password='false'
   has_keyfile='false'
   has_tpm='false'
   if [ "${encrypt}" = 'true' ]; then
      if [ -z "${key_type}" ]; then
         die 1 "--key-type is mandatory with --encrypt true (password, keyfile, tpm; comma-separated)."
      fi
      parse_key_type "${key_type}"
      if [ "${has_password}" = 'false' ] && [ "${has_keyfile}" = 'false' ] \
         && [ "${has_tpm}" = 'false' ]; then
         die 1 "--key-type selected no method."
      fi
      if [ "${has_password}" = 'true' ] && [ -z "${passphrase_file}" ]; then
         die 1 "--key-type password requires --passphrase-file (or '-' for stdin)."
      fi
      if [ "${has_keyfile}" = 'true' ]; then
         if [ -z "${keyfile}" ]; then
            die 1 "--key-type keyfile requires --keyfile."
         fi
         if [ ! -r "${keyfile}" ]; then
            die 1 "--keyfile '${keyfile}' is not readable."
         fi
         ## Reject a trivially small key (a lone newline is 1 byte and cryptsetup
         ## would accept it as the key). Not an entropy check -- just a floor.
         keyfile_size="$(stat -c %s -- "${keyfile}")"
         if [ "${keyfile_size}" -lt 16 ]; then
            die 1 "--keyfile '${keyfile}' is too small (${keyfile_size} bytes); need at least 16 bytes of key material."
         fi
      fi
      if ! [[ "${luks_uuid}" =~ ^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$ ]]; then
         die 1 "--luks-uuid must be a UUID, got '${luks_uuid}'."
      fi
      plan_encryption
      if [ "${encrypt}" = 'true' ]; then
         persist_type_guid="${persist_type_guid_luks}"
      fi
   else
      if [ -n "${key_type}" ] || [ -n "${passphrase_file}" ] || [ -n "${keyfile}" ]; then
         die 1 "--key-type/--passphrase-file/--keyfile are meaningless with --encrypt false."
      fi
      persist_type_guid="${persist_type_guid_plain}"
   fi

   if [ "${target}" = 'disk' ] && [ -z "${device_opt}" ]; then
      die 1 "--target disk requires --device."
   fi

   ## --- preflight dependencies --------------------------------------------
   die_if_not_has lsblk blkid sgdisk wipefs cryptsetup udevadm mount umount \
      mktemp findmnt shred awk partprobe sort comm stat "mkfs.${filesystem}"
   if [ "${encrypt}" = 'true' ]; then
      ## The unencrypted boot area is always ext4, regardless of --filesystem.
      die_if_not_has mkfs.ext4
   fi
   if [ "${enroll_tpm:-false}" = 'true' ]; then
      die_if_not_has systemd-cryptenroll
   fi

   as_root

   ## --- only after live-mode confirmation do we touch a device ------------
   ## Overridable only for the loop-device engine test (default is production).
   cmdline_file="${PERSISTENCE_SETUP_CMDLINE_FILE:-/proc/cmdline}"
   kernel_cmdline=''
   if [ -r "${cmdline_file}" ]; then
      kernel_cmdline="$(cat -- "${cmdline_file}")"
   fi
   if [[ " ${kernel_cmdline} " != *" rd.live.image "* ]] \
      && [[ " ${kernel_cmdline} " != *" rd.live.image=1 "* ]]; then
      die 1 "'rd.live.image' not on the kernel command line; this tool only runs in ISO live mode."
   fi

   ## --- resolve the target device -----------------------------------------
   device=''
   boot_disk=''
   resolve_boot_disk
   if [ "${target}" = 'usb-freespace' ]; then
      if [ -n "${device_opt}" ]; then
         ## Explicit override (also how the loop-device test drives usb-freespace).
         device="${device_opt}"
      else
         if [ -z "${boot_disk}" ]; then
            die 1 "could not resolve the booted USB device; pass --device explicitly."
         fi
         device="${boot_disk}"
      fi
   else
      candidate_disk_list=()
      build_candidate_disk_list
      device_opt_name="${device_opt#/dev/}"
      device_ok='false'
      for candidate_disk in "${candidate_disk_list[@]}"; do
         if [ "${candidate_disk}" = "${device_opt_name}" ]; then
            device_ok='true'
            break
         fi
      done
      if [ "${device_ok}" = 'false' ]; then
         die 1 "'${device_opt}' is not an eligible whole, unmounted disk."
      fi
      device="${device_opt}"
   fi
   if [ ! -b "${device}" ]; then
      die 1 "'${device}' is not a block device."
   fi
   ## A whole disk, never a partition -- sgdisk operates on the disk, and
   ## `sgdisk -e` on a partition would corrupt it.
   device_type="$(lsblk --noheadings --nodeps --output TYPE -- "${device}" 2>/dev/null | head --lines 1 || true)"
   case "${device_type}" in
      disk|loop)
         true "INFO: '${device}' is a whole disk, ok."
         ;;
      *)
         die 1 "'${device}' is not a whole disk (type '${device_type}'); refusing."
         ;;
   esac
   ## Never the boot disk under --target disk (that is what usb-freespace is for).
   ## Compare by kernel NAME: boot_disk is /dev/-prefixed (lsblk --paths) but
   ## --device may be given bare ('sda'), so a raw string compare would miss it.
   if [ "${target}" = 'disk' ] && [ -n "${boot_disk}" ] \
      && [ "${device#/dev/}" = "${boot_disk#/dev/}" ]; then
      die 1 "'${device}' is the booted live disk; use --target usb-freespace for it."
   fi

   ## --- refuse to clobber existing content unless --force -----------------
   ## Per-column lsblk (not multi-column: --raw collapses empty fields and
   ## misparses under a single read).
   existing_state=''
   if [ "${target}" = 'disk' ]; then
      ## A whole second disk is ours; ANY pre-existing table or filesystem is
      ## data we would destroy -- require --force over it.
      if [ -n "$(blkid -o value -s PTTYPE -- "${device}" 2>/dev/null || true)" ]; then
         existing_state='an existing partition table'
      elif [ -n "$(blkid -o value -s TYPE -- "${device}" 2>/dev/null || true)" ]; then
         existing_state='an existing filesystem'
      fi
   else
      ## usb-freespace: only OUR overlay counts (the ISO partitions are
      ## expected). Capture each column first (a here-string, not a pipe into
      ## grep -q).
      col_fstype="$(lsblk --noheadings --raw --output FSTYPE -- "${device}")"
      col_partlabel="$(lsblk --noheadings --raw --output PARTLABEL -- "${device}")"
      col_label="$(lsblk --noheadings --raw --output LABEL -- "${device}")"
      if grep --fixed-strings --line-regexp --quiet -- 'crypto_LUKS' <<< "${col_fstype}"; then
         existing_state='a LUKS container'
      elif grep --fixed-strings --line-regexp --quiet -e "${persistence_label}" -e "${boot_label}" <<< "${col_partlabel}"; then
         existing_state='an existing overlay partition'
      elif grep --fixed-strings --line-regexp --quiet -- "${persistence_label}" <<< "${col_label}"; then
         existing_state="an existing '${persistence_label}' filesystem"
      fi
   fi
   if [ "${force}" != 'true' ] && [ -n "${existing_state}" ]; then
      die 1 "'${device}' already holds ${existing_state}; re-run with --force to reformat."
   fi

   trap persistence_setup_cleanup EXIT

   ## --- prepare key material (RAM-only) -----------------------------------
   primary_key_file=''
   if [ "${encrypt}" = 'true' ] && [ "${primary_key_kind}" = 'password' ]; then
      read_passphrase
      if [ -z "${passphrase}" ]; then
         die 1 "empty passphrase read from '${passphrase_file}'."
      fi
      if [ "${allow_weak_passphrase}" = 'false' ]; then
         if ! printf '%s' "${passphrase}" | password_strength_check; then
            die 1 "passphrase too weak (maximum strength score required). Re-run with --allow-weak-passphrase to override."
         fi
      fi
   fi
   if [ "${encrypt}" = 'true' ]; then
      make_primary_key_file
   fi

   ## --- carve + format ----------------------------------------------------
   if [ "${target}" = 'disk' ]; then
      ## A whole dedicated disk: start from a clean GPT. --zap-all clears any
      ## GPT, MBR/DOS label and foreign LUKS (guarded by the content check +
      ## --force above), so create always lands on empty, aligned free space --
      ## and it works on a DOS-labelled disk, which `sgdisk -o` refuses.
      log_run notice sgdisk --zap-all "${device}"
   else
      ## usb-freespace: preserve the ISO partitions. On --force drop only OUR
      ## overlay partitions (BEFORE sgdisk -e, whose kernel re-read would race
      ## the PARTLABEL read). Then relocate the isohybrid backup-GPT header to
      ## the true device end so the trailing free space is usable.
      if [ "${force}" = 'true' ]; then
         delete_overlay_partitions
      fi
      log_run notice sgdisk -e "${device}"
   fi

   ## Captures the EXACT new nodes into persistence_partition / boot_partition.
   create_partitions

   if [ "${encrypt}" = 'true' ]; then
      log_run notice wipefs --all -- "${boot_partition}"
      mkfs.ext4 -L "${boot_label}" "${boot_partition}"
   fi

   provision_persistence_fs "${persistence_partition}"

   ## --- report ------------------------------------------------------------
   log notice "Done. '${device}' now carries a '${persistence_label}' overlay."
   if [ "${encrypt}" != 'true' ]; then
      log notice "Reboot and pick the plaintext persistence boot entry."
   else
      if [ "${has_password}" = 'true' ]; then
         log notice "At boot, systemd-cryptsetup prompts for the passphrase."
      fi
      if [ "${has_keyfile}" = 'true' ]; then
         log notice "The keyfile unlocks the overlay (keep it available at boot)."
      fi
      if [ "${has_tpm}" = 'true' ]; then
         log notice "A TPM2 slot was enrolled: it auto-unlocks on THIS machine only."
      fi
   fi
}

if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
