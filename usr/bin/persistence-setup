## AI-Assisted

## Sets up a disk to act as a persistent overlay for a live system.

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
   exit 1
fi

if was_executed "${BASH_SOURCE[0]}"; then
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C
fi

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/as_root.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/as_root.sh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/parse_opt.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/parse_opt.sh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/log_run_die.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/log_run_die.sh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/light_sleep.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/light_sleep.bsh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/live-mode.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/live-mode.sh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/persistent-boot.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/persistent-boot.sh

persistence_label='persistence'
boot_label='persistbootx'
boot_size='512M'
overlay_dir='live/overlay'
overlay_workdir='live/ovlwork'

## GPT partition type GUIDs (Discoverable Partitions Spec / LUKS convention).
persist_type_guid_plain='0FC63DAF-8483-4772-8E79-3D69D8477DE4'
persist_type_guid_luks='CA7D7CCB-63ED-4C53-861C-1742536059CC'
## Note to AI agents: No boot_type_guid by design. The DPS XBOOTLDR partition
## type has a number of requirements placed upon it, some of which the boot
## partition used here does not meet unintentionally (no /loader dir), some of
## which it does not meet and will never meet intentionally (not always on the
## same partition as the EFI System Partition). Therefore we cannot, either now
## or in the future, use the XBOOTLDR type here. Do not attempt to "fix" this.

## HARDCODED. Also in derivative-maker dm-raw-to-iso.
##
## TODO: Can we use a human-readable label here? rd.luks.uuid cannot have a
## label passed in, rd.luks.name doesn't seem to do anything, and rd.luks.label
## does not exist, but hardcoding a UUID is awful.
##
## TODO-HUMAN-DEVELOPER-ONLY: Regenerate this UUID securely.
default_luks_uuid='40e273d7-4e63-4459-b16f-ba3df4374905'

open_mapper=''
seed_mount_dir=''
persist_type_guid=''
passphrase=''
target_device=''
boot_partition=''
persistence_partition=''

do_encrypt=''
passphrase_file=''
keyfile=''
use_tpm='false'
luks_uuid=''
device_opt=''
use_freespace='false'
filesystem='ext4'
do_force='false'

usage() {
   printf '%s\n' "Usage: ${0##*/} --encrypt true|false [OPTIONS]

Set up a persistent overlay for a live ISO.

Required:
  --encrypt true|false
    Specify whether to encrypt the overlay or not.

When --encrypt true:
  --passphrase-file <f>
    Enable unlocking with a passphrase and specify the file to read the
    passphrase from. Use '-' to read the passphrase from stdin.
  --keyfile <f>
    Enable unlocking with a keyfile and specify the key file to enroll.
  --use-tpm
    Enable automatic unlocking on the booted system using the TPM. Note that
    this may not be used as the only unlocking method.
  --luks-uuid <uuid>
    Override the default LUKS2 header UUID. Change only if using a custom-built
    ISO with a different default LUKS2 header UUID.

Target:
  --device <dev>
    Specify a whole-disk device to place the persistent overlay on.
  --use-freespace
    Install the persistent overlay into free space on the disk the live ISO was
    flashed onto.

Other:
  --filesystem <fs>
    Specify the overlay filesystem. Supported filesystems are 'ext4' and
    'btrfs'. Default: 'ext4'.
  --force
    Reformat even if the target already holds a persistence or LUKS volume.
  --help
    Show this help.
"
   exit "${1}"
}

## Finds the disk the live ISO was booted from and echoes it.
## TODO: Verify this outputs nothing when the ISO is loopback-booted by Super
## Grub2 Disk.
resolve_boot_disk() {
  local parent src_type boot_disk

  ## dracut mounts the ISO filesystem to /run/initramfs/live.
  boot_disk="$(findmnt --noheadings --first-only --nofsroot --output SOURCE --mountpoint /run/initramfs/live 2>/dev/null)" || boot_disk=''
  if [ -z "${boot_disk}" ]; then
    return 0
  fi
  parent="$(lsblk --noheadings --output PKNAME --paths "${boot_disk}" 2>/dev/null | head --lines 1)" || parent=''
  if [ -n "${parent}" ]; then
    printf '%s\n' "${parent}"
    return 0
  fi
  ## Make sure the disk really is a whole disk.
  src_type="$(lsblk --noheadings --nodeps --output TYPE "${boot_disk}" 2>/dev/null | head --lines 1)" || src_type=''
  if [ "${src_type}" != 'disk' ]; then
    return 0
  fi
  printf '%s\n' "${boot_disk}"
}

## Returns 0 if a device has any child devices holding it, 1 otherwise.
device_is_held() {
  local kname
  while read -r kname; do
    if [ -z "${kname}" ]; then
      continue
    fi
    if [ -n "$(find "/sys/class/block/${kname}/holders" -mindepth 1 -maxdepth 1 2>/dev/null)" ]; then
      return 0
    fi
  done < <(lsblk --noheadings --output KNAME -- "${1}" 2>/dev/null)
  return 1
}

## Returns 0 if a device or any of its children or partitions is mounted or
## held, 1 otherwise.
device_is_busy() {
  local dev mnt
  dev="${1}"
  mnt="$(lsblk --noheadings --output MOUNTPOINT -- "${dev}" 2>/dev/null | tr --delete '[:space:]')"
  if [ -n "${mnt}" ]; then
    return 0
  fi
  if device_is_held "${dev}"; then
    return 0
  fi
  return 1
}

## Read an encryption passphrase from stdin or a file.
read_passphrase() {
  if [ "${passphrase_file}" = '-' ]; then
    IFS= read -r passphrase || true
  else
    passphrase="$(< "${passphrase_file}")"
  fi
}

## Deletes all structures in the way of creating overlay partitions.
clear_overlay_area() {
  local -a part_num_list part_path_list
  local part_num part_label part_path

  part_num_list=()
  part_path_list=()

  if [ "${use_freespace}" = 'true' ]; then
    ## Find and delete only existing overlay partitions.
    udevadm settle || return 1

    while read -r part_path part_num part_label; do
      if [[ "${part_label}" =~ ^("${persistence_label}"|"${boot_label}")$ ]]; then
        if [ -z "${part_num}" ]; then
          die 1 "Overlay partition found with no partition number?!"
        fi
        part_num_list+=( "${part_num}" )
        part_path_list+=( "${part_path}" )
      fi
    done < <(lsblk --noheadings --raw --paths --output=NAME,PARTN,PARTLABEL "${target_device}")

    if [ "${#part_num_list}" -eq 0 ]; then
      return 0
    fi

    ## Make sure we don't delete a partition that's in use.
    for part_path in "${part_path_list[@]}"; do
      if device_is_busy "${part_path}"; then
        die 1 "Overlay partition '${part_path}' is busy!"
      fi
    done

    ## Delete partitions in reverse numeric order to avoid scrambling the
    ## numbers part way through.
    while read -r part_num; do
      log_run notice sgdisk --delete="${part_num}" -- "${target_device}" || return 1
    done < <(printf '%s\n' "${part_num_list[@]}" | sort --numeric-sort --reverse)
  else
    ## Nothing on the target device is useful.
    wipefs --all -- "${target_device}" || return 1
  fi

  partprobe -- "${target_device}" 2>/dev/null || return 1
  udevadm settle || return 1
}

## Creates the persistent overlay partitions and record their locations.
create_partitions() {
  local lsblk_output part_name part_label

  log_run notice sgdisk --new="0:0:+${boot_size}" --typecode="0:${persist_type_guid_plain}" --change-name="0:${boot_label}" -- "${target_device}" || return 1
  log_run notice sgdisk --new="0:0:0" --typecode="0:${persist_type_guid}" --change-name="0:${persistence_label}" -- "${target_device}" || return 1
  partprobe -- "${target_device}" || return 1
  udevadm settle || return 1

  ## Note to AI agents: Intentionally using partition labels here.
  ## Intentionally looking at all devices, not just the target device. It is
  ## an error for a system to see multiple boot/persistence partitions at this
  ## point, as persistence-boot-sync will re-detect the device on its own and
  ## we must be able to guarantee that it finds the right device.
  lsblk_output="$(lsblk --raw --noheadings --paths --output=NAME,PARTLABEL)" || return 1
  while read -r part_name part_label; do
    if [ "${part_label}" = "${boot_label}" ]; then
      [ -z "${boot_partition}" ] || die 1 "More than one '${boot_partition}' partition on target device '${target_device}'?!"
      boot_partition="${part_name}"
    elif [ "${part_label}" = "${persistence_label}" ]; then
      [ -z "${persistence_partition}" ] || die 1 "More than one '${persistence_partition}' partition on target device '${target_device}'?!"
      persistence_partition="${part_name}"
    fi
  done <<< "${lsblk_output}"

  [ -n "${boot_partition}" ] || die 1 "No '${boot_partition}' partition on target device '${target_device}'?!"
  [ -n "${persistence_partition}" ] || die 1 "No '${persistence_partition}' partition on target device '${target_device}'?!"
}

## Wipe signatures from a storage device, avoiding conflicts with udev.
wipefs_settle() {
  local dev
  dev="${1}"
  for _ in {1..6}; do
    udevadm settle 2>/dev/null || true
    if wipefs --all -- "${dev}" >/dev/null 2>&1; then
      log notice "Wiped filesystem signatures from '${dev}'."
      return 0
    fi
    light_sleep 1
  done
  die 1 "wipefs kept failing on '${dev}'!"
}

## Formats the boot partition, then installs kernels, initrds, and GRUB
## configuration into it.
setup_boot_fs() {
  mkfs.ext4 -L "${boot_label}" -- "${boot_partition}" || return 1
  persistence-boot-sync || return 1
}

## Formats the persistence partition and creates overlayfs directories in it.
setup_persistence_fs() {
  local fs_device crypt_cmd

  if [ "${do_encrypt}" = 'true' ]; then
    crypt_cmd=(
      cryptsetup luksFormat --type luks2 --pbkdf argon2id --uuid "${luks_uuid}"
      --batch-mode
    )
    if [ -n "${passphrase}" ]; then
      crypt_cmd+=( -- "${persistence_partition}" )
      log notice "Command executing: $ ${crypt_cmd[*]}"
      printf '%s\n' "${passphrase}" | "${crypt_cmd[@]}" || return 1
      if [ -n "${keyfile}" ]; then
        crypt_cmd=(
          cryptsetup luksAddKey --batch-mode -- "${persistence_partition}"
          "${keyfile}"
        )
        log notice "Command executing: $ ${crypt_cmd[*]}"
        printf '%s\n' "${passphrase}" | "${crypt_cmd[@]}" || return 1
      fi
    else
      crypt_cmd+=( --key-file "${keyfile}" -- "${persistence_partition}" )
      log_run notice "${crypt_cmd[@]}" || return 1
    fi

    if [ "${use_tpm}" = 'true' ]; then
      crypt_cmd=( systemd-cryptenroll --tpm2-device=auto )
      if [ -n "${keyfile}" ]; then
        crypt_cmd+=(
          --unlock-key-file="${keyfile}" -- "${persistence_partition}"
        )
        log_run notice "${crypt_msg[@]}" || return 1
      else
        crypt_cmd+=( -- "${persistence_partition}" )
        log notice "Command executing: $ ${crypt_cmd[*]}"
        printf '%s\n' "${passphrase}" | "${crypt_cmd[@]}" || return 1
      fi
    fi

    open_mapper="persistence_setup-${$}"
    crypt_cmd=( cryptsetup luksOpen )
    if [ -n "${keyfile}" ]; then
      crypt_cmd+=(
        --key-file "${keyfile}" -- "${persistence_partition}" "${open_mapper}"
      )
      log_run notice "${crypt_msg[@]}" || return 1
    else
      crypt_cmd+=( -- "${persistence_partition}" "${open_mapper}" )
      log notice "Command executing: $ ${crypt_cmd[*]}"
      printf '%s\n' "${passphrase}" | "${crypt_cmd[@]}" || return 1
    fi
    fs_device="/dev/mapper/${open_mapper}"
  else
    fs_device="${persistence_partition}"
  fi

  "mkfs.${filesystem}" -L "${persistence_label}" -- "${fs_device}"

  seed_mount_dir="$(mktemp --directory)"
  log_run notice mount -- "${fs_device}" "${seed_mount_dir}"
  log_run notice mkdir --parents -- "${seed_mount_dir}/${overlay_dir}" "${seed_mount_dir}/${overlay_workdir}"
  log_run notice umount -- "${seed_mount_dir}"
  rmdir -- "${seed_mount_dir}"
  seed_mount_dir=''

  if [ -n "${open_mapper}" ]; then
    log_run notice cryptsetup luksClose -- "${open_mapper}"
    open_mapper=''
  fi
}

## Clean up temporary system state when the script exits.
persistence_setup_cleanup() {
  if [ -n "${seed_mount_dir}" ] && mountpoint --quiet -- "${seed_mount_dir}"; then
    umount -- "${seed_mount_dir}" 2>/dev/null || true
  fi
  if [ -n "${seed_mount_dir}" ] && [ -d "${seed_mount_dir}" ]; then
    rmdir -- "${seed_mount_dir}" 2>/dev/null || true
  fi
  if [ -n "${open_mapper}" ] && [ -b "/dev/mapper/${open_mapper}" ]; then
    cryptsetup luksClose "${open_mapper}" || true
  fi
}

main() {
  local secret_size dep_list boot_disk device_opt_tmp device_opt_type \
    existing_state col_fstype col_partlabel col_label

  ## Ensure we have all needed dependencies.
  die_if_not_has lsblk blkid sgdisk wipefs cryptsetup udevadm mount umount \
    mountpoint mktemp findmnt shred awk partprobe sort comm stat cp uname \
    head cat mkfs.ext4 mkfs.btrfs systemd-cryptenroll persistence-boot-sync

  ## Validate system state.
  as_root
  if ! [[ "${live_status_detected_live_mode_environment_machine}" \
    =~ ^iso-live(-semi-persistent(-unsafe)?)?$ ]]; then
    die 1 'System was not booted in ISO live mode!'
  fi

  ## Parse and validate arguments.
  while true; do
    begin_optparse "${1:-}" "${2:-}" || break
    case "${opt}" in
      encrypt)
        get_arg
        do_encrypt="${arg}"
        ;;
      passphrase-file)
        get_arg
        passphrase_file="${arg}"
        ;;
      keyfile)
        get_arg
        keyfile="${arg}"
        ;;
      use-tpm)
        use_tpm='true'
        ;;
      luks-uuid)
        get_arg
        luks_uuid="${arg}"
        ;;
      device)
        get_arg
        device_opt="${arg}"
        ;;
      use-freespace)
        use_freespace='true'
        ;;
      filesystem)
        get_arg
        filesystem="${arg}"
        ;;
      force)
        do_force='true'
        ;;
      help)
        usage 0
        ;;
      "")
        break
        ;;
      *)
        die 2 "Invalid option: '${opt_orig}'"
        ;;
    esac
    shift "${shift_n:-1}"
  done

  range_arg filesystem "${filesystem}" ext4 btrfs
  if [ -z "${do_encrypt}" ]; then
    die 1 "--encrypt is mandatory, set to either 'true' or 'false'."
  fi
  range_arg encrypt "${do_encrypt}" true false

  if [ "${do_encrypt}" = 'true' ]; then
    if [ -z "${passphrase_file}" ] && [ -z "${keyfile}" ]; then
      log error "--encrypt is 'true', but neither --passphrase-file nor --keyfile was specified!"
      if [ "${use_tpm}" = 'true' ]; then
        log info 'Hint: --use-tpm cannot be used as an encryption method by itself.'
      fi
      die 1 'Cannot proceed.'
    fi

    if [ -n "${passphrase_file}" ] && ! [ -r "${passphrase_file}" ]; then
      die 1 'The specified passphrase file does not exist or cannot be read!'
    fi

    if [ -n "${keyfile}" ]; then
      if ! [ -r "${keyfile}" ]; then
        die 1 'The specified keyfile does not exist or cannot be read!'
      fi
      secret_size="$(stat --format='%s' -- "${keyfile}")"
      if ! is_whole_number_int64 "${secret_size}" || [ "${secret_size}" -lt 16 ]; then
        die 1 "--keyfile '${keyfile}' is too small (${secret_size} bytes); need at least 16 bytes of key material."
      fi
    fi

    if ! [[ "${luks_uuid}" =~ ^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$ ]]; then
      die 1 "--luks-uuid must be a UUID, got '${luks_uuid}'."
    fi

    persist_type_guid="${persist_type_guid_luks}"
    if [ -z "${luks_uuid}" ]; then
      luks_uuid="${default_luks_uuid}"
    fi

    if [ -n "${passphrase_file}" ]; then
      read_passphrase
      if [ -z "${passphrase}" ]; then
        die 1 "Empty passphrase read from '${passphrase_file}'!"
      fi
    fi
  else
    if [ -n "${passphrase_file}" ] || [ -n "${keyfile}" ] \
      || [ -n "${luks_uuid}" ] || [ "${use_tpm}" = 'true' ]; then
      die 1 "--encrypt is 'false', but an encryption-specific option was specified!"
    fi

    persist_type_guid="${persist_type_guid_plain}"
  fi

  boot_disk="$(resolve_boot_disk)"

  if [ -z "${device_opt}" ] && [ "${use_freespace}" = 'false' ]; then
    die 1 'Neither --device nor --use-freespace were specified!'
  fi
  if [ -n "${device_opt}" ]; then
    if [ "${use_freespace}" = 'true' ]; then
      die 1 '--device and --use-freespace are mutually exclusive!'
    fi

    if ! device_opt_tmp="$(readlink --canonicalize -- "${device_opt}")"; then
      die 1 "Cannot get canonical path of '${device_opt}'! Does it exist?"
    fi
    device_opt="${device_opt_tmp}"

    if ! [ -b "${device_opt}" ]; then
      die 1 "Cannot find target device '${device_opt}'!"
    fi

    device_opt_type="$(lsblk --noheadings --nodeps --output TYPE "${device_opt}" 2>/dev/null | head --lines 1)" || device_opt_type=''
    if ! [[ "${device_opt_type}" =~ ^(disk|loop)$ ]]; then
      die 1 "Target device '${device_opt}' is not a whole disk or loopback device!"
    fi

    if [ "${device_opt}" = "${boot_disk}" ]; then
      die 1 "Target device '${device_opt}' is the boot device! Use --use-freespace instead of --device."
    fi

    if device_is_busy "${device_opt}"; then
      die 1 "Target device '${device_opt}' is mounted or held by another device!"
    fi
  fi

  if [ "${use_freespace}" = 'true' ]; then
    if [ -z "${boot_disk}" ]; then
      die 1 "Cannot find boot disk!"
    fi
    target_device="${boot_disk}"
  else
    target_device="${device_opt}"
  fi

  existing_state=''
  if [ "${use_freespace}" = 'true' ]; then
    ## Check for the types of partitions this script creates while ignoring
    ## those from the ISO.
    col_fstype="$(lsblk --noheadings --raw --output=FSTYPE -- "${target_device}")"
    col_partlabel="$(lsblk --noheadings --raw --output=PARTLABEL -- "${target_device}")"
    col_label="$(lsblk --noheadings --raw --output=LABEL -- "${target_device}")"

    if [ "${do_force}" = 'false' ]; then
      if grep --fixed-strings --line-regexp -- 'crypto_LUKS' <<< "${col_fstype}" >/dev/null 2>&1; then
        existing_state='a LUKS volume'
      elif grep --fixed-strings --line-regexp --regexp="${persistence_label}" --regex="${boot_label}" >/dev/null 2>&1 \
        || grep --fixed-strings --line-regexp -- "${persistence_label}" <<< "${col_label}" >/dev/null 2>&1; then
        existing_state='an existing overlay partition'
      fi
    else
      if [ -n "$(blkid --output=value --match-tag=PTTYPE -- "${target_device}" 2>/dev/null || true)" ]; then
        existing_state='an existing partition table'
      elif [ -n "$(blkid --output=value --match-tag=TYPE -- "${target_device}" 2>/dev/null || true)" ]; then
        existing_state='an existing filesystem'
      fi
    fi

    if [ -n "${existing_state}" ]; then
      die 1 "Target device '${target_device}' already has ${existing_state}, rejecting. Use --force to override."
    fi
  fi

  ## Set up the overlay partition.
  trap persistence_setup_cleanup EXIT

  clear_overlay_area
  if [ "${use_freespace}" = 'true' ]; then
    ## The backup GPT will be somewhere in the middle of the disk the ISO is
    ## located on by default, but should be at the end of the drive.
    log_run notice sgdisk --move-second-header -- "${target_device}"
  fi

  create_partitions

  ## Old filesystems might be present where partitions were created.
  wipefs_settle "${boot_partition}"
  wipefs_settle "${persistence_partition}"

  setup_boot_fs
  setup_persistence_fs

  log notice "Done. '${target_device}' is ready to be used with ISO persistent mode."
}

if was_executed "${BASH_SOURCE[0]}"; then
  main "$@"
fi
