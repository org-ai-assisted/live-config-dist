## Calamares job 'shellprocess@grub_setup', runs right after the 'bootloader' job.
##
## Why it exists (EFI only):
## - The 'bootloader' job (installEFIFallback: true) copies PLAIN grubx64.efi to the
##   removable path EFI/BOOT/BOOTX64.EFI. Firmware booting that path under Secure Boot
##   refuses it. Observed on a test install: BOOTX64.EFI hash == grubx64.efi, != shimx64.efi.
## - grub-efi's postinst cannot fix this at package install time: it only runs
##   grub-install when /boot/grub/<target>/core.efi already exists, which is not yet the
##   case on a fresh target (calamares-bootloader-config.dist installs grub-efi before
##   'bootloader' runs).
## - Here, after 'bootloader', 'dpkg-reconfigure grub-efi-<arch>' with
##   grub2/force_efi_extra_removable=true runs grub-install --force-extra-removable,
##   which puts the shim at EFI/BOOT/BOOTX64.EFI.
##
## Why there is no grub-pc branch (BIOS): see the else-branch below.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/package_installed_check.sh
source /usr/libexec/helper-scripts/package_installed_check.sh

## DEBUG (temporary, BIOS grub-pc investigation): mirror output into a log that
## survives on the installed disk (Calamares does not surface it).
mkdir --parents -- /var/log/live-config-dist
exec > >(tee --append -- /var/log/live-config-dist/finish-grub-setup.log) 2>&1
debug_err_trap() {
   local rc=$?
   printf '%s\n' "$0: DEBUG: FAILED rc=${rc} at line ${BASH_LINENO[0]}"
}
trap debug_err_trap ERR
printf '%s\n' "$0: DEBUG: id: '$(id)' TMPDIR='${TMPDIR:-<unset>}'"
if [ -n "${TMPDIR:-}" ]; then
   printf '%s\n' "$0: DEBUG: TMPDIR exists: $(test -d "${TMPDIR}" && printf '%s' yes || printf '%s' NO)"
fi
printf '%s\n' "$0: DEBUG: grub-pc debconf:"
debconf-show grub-pc 2>&1 || true

system_arch="$(dpkg --print-architecture)"

grub_pc_dpkg_query_output="$(dpkg-query --show --showformat='${Status}' "grub-pc" 2>&1)" || true
grub_efi_dpkg_query_output="$(dpkg-query --show --showformat='${Status}' "grub-efi-${system_arch}" 2>&1)" || true

printf '%s\n' "$0: DEBUG: system_arch: '${system_arch}'"
printf '%s\n' "$0: DEBUG: grub-pc grub_pc_dpkg_query_output: '${grub_pc_dpkg_query_output}'"
printf '%s\n' "$0: DEBUG: grub-efi-${system_arch} grub_efi_dpkg_query_output: '${grub_efi_dpkg_query_output}'"

if pkg_installed "grub-efi-${system_arch}"; then
   printf '%s\n' "$0: DEBUG: branch taken: grub-efi-${system_arch}"
   printf '%s\n' "grub-efi-${system_arch} grub2/force_efi_extra_removable boolean true" | debconf-set-selections
   dpkg-reconfigure-noninteractive "grub-efi-${system_arch}"
else
   ## No grub-pc branch: calamares-bootloader-config.dist seeds grub-pc/install_devices
   ## before installing grub-pc, whose postinst then installs GRUB to that disk, and it
   ## aborts the install if it cannot. Re-seeding + dpkg-reconfigure here would only
   ## repeat the same grub-install.
   printf '%s\n' "$0: DEBUG: branch taken: NONE (grub-efi-${system_arch} not fully installed)"
fi
