set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/package_installed_check.sh
source /usr/libexec/helper-scripts/package_installed_check.sh

system_arch="$(dpkg --print-architecture)"
if pkg_installed "grub-efi-${system_arch}"; then
   printf '%s\n' "grub-efi-${system_arch} grub2/force_efi_extra_removable boolean true" | debconf-set-selections
   dpkg-reconfigure --frontend=noninteractive "grub-efi-${system_arch}"
elif pkg_installed grub-pc; then
   ## BIOS: Calamares installs grub-pc at its bootloader step with grub-pc/install_devices
   ## unset, so grub-pc's postinst aborts there ("You must correct your GRUB install devices")
   ## and the package is left HALF-CONFIGURED. Seed the device, then COMPLETE the pending
   ## configuration -- `dpkg --configure` re-runs the postinst on a half-configured package;
   ## `dpkg-reconfigure` cannot (it refuses "grub-pc is broken or not fully installed").
   ## EFI has no such prompt, hence the grub-efi branch only reconfigures.

   ## Own line, not a pipe: errexit catches a grub-probe failure here (in a pipe the
   ## substitution takes the filter's zero exit and silently seeds an empty device).
   grub_pc_disks="$(grub-probe --target=disk /boot/grub)"

   ## One disk per line -> one comma-separated multiselect value (bash join, no external
   ## filter). $() stripped the trailing newline, so a single disk stays bare.
   install_devices="${grub_pc_disks//$'\n'/, }"

   printf '%s\n' "grub-pc grub-pc/install_devices multiselect ${install_devices}" | debconf-set-selections
   DEBIAN_FRONTEND=noninteractive dpkg --configure grub-pc
fi
