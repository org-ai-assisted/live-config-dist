## AI-Assisted

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Kernel postinst.d hook. Under a persistent live overlay, the signed ISO grub
## boots an UPGRADED kernel only if it lives on a grub-readable (unencrypted)
## boot area with a matching grub.cfg. After a kernel install this hook syncs the
## just-installed signed kernel+initrd into that area (persistbootx for an
## encrypted overlay, else the plaintext persistence partition) and rewrites its
## grub.cfg. Supersedes the former warn-only hook.
##
## BEST-EFFORT: a sync failure WARNS loudly but never aborts the kernel upgrade --
## a half-configured dpkg state is worse than a stale boot menu. sync_boot_area is
## called in an if-condition (errexit suppressed there), so every step is checked
## explicitly; the EXIT trap unwinds the mount.

kernel_version="${1:-}"
helper_scripts_path="${HELPER_SCRIPTS_PATH:-}"
## Where the just-installed kernel+initrd live (dpkg puts them in /boot).
## Overridable for tests; production is /boot.
kernel_src_dir="${LIVE_PERSISTENCE_KERNEL_SRC:-/boot}"

# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/persistent-boot.sh
source "${helper_scripts_path}/usr/libexec/helper-scripts/persistent-boot.sh"

mount_dir=''
## Invoked via the EXIT trap, which shellcheck does not see as a call (SC2317).
# shellcheck disable=SC2317
boot_sync_cleanup() {
   if [ -n "${mount_dir}" ] && mountpoint --quiet -- "${mount_dir}" 2>/dev/null; then
      umount -- "${mount_dir}" 2>/dev/null || true
   fi
   if [ -n "${mount_dir}" ] && [ -d "${mount_dir}" ]; then
      rmdir -- "${mount_dir}" 2>/dev/null || true
   fi
}
trap boot_sync_cleanup EXIT

sync_boot_area() {
   local boot_dev luks_uuid boot_dir cmdline token
   local -a cmdline_tokens

   ## Encrypted overlay -> the unencrypted 'persistbootx' area; plaintext overlay
   ## -> the 'persistence' ext4 itself (grub reads both, LUKS it cannot). The fs
   ## label is visible only on the unencrypted member, so presence disambiguates.
   boot_dev="$(blkid --label persistbootx 2>/dev/null)" || boot_dev=''
   luks_uuid=''
   if [ -n "${boot_dev}" ]; then
      read -r -a cmdline_tokens < "${PERSISTENT_BOOT_CMDLINE_FILE:-/proc/cmdline}" || return 1
      for token in "${cmdline_tokens[@]}"; do
         case "${token}" in
            rd.luks.uuid=*)
               luks_uuid="${token#rd.luks.uuid=}"
               ;;
         esac
      done
   else
      boot_dev="$(blkid --label persistence 2>/dev/null)" || boot_dev=''
   fi
   if [ -z "${boot_dev}" ]; then
      printf '%s\n' "live-persistence boot sync: no persistbootx/persistence boot area found." >&2
      return 1
   fi
   if [ ! -e "${kernel_src_dir}/vmlinuz-${kernel_version}" ] \
      || [ ! -e "${kernel_src_dir}/initrd.img-${kernel_version}" ]; then
      printf '%s\n' "live-persistence boot sync: ${kernel_src_dir}/{vmlinuz,initrd.img}-${kernel_version} missing." >&2
      return 1
   fi

   mount_dir="$(mktemp --directory)" || return 1
   mount -- "${boot_dev}" "${mount_dir}" || return 1
   boot_dir="${mount_dir}/boot"
   mkdir --parents -- "${boot_dir}" || return 1
   cp -- "${kernel_src_dir}/vmlinuz-${kernel_version}" "${boot_dir}/vmlinuz-${kernel_version}" || return 1
   cp -- "${kernel_src_dir}/initrd.img-${kernel_version}" "${boot_dir}/initrd.img-${kernel_version}" || return 1
   cmdline="$(persistent_boot_cmdline persistence "${luks_uuid}")" || return 1
   persistent_boot_write_grub_cfg "${boot_dir}" "${cmdline}" || return 1
   return 0
}

## Only act in a live boot with persistence active (an installed-to-disk or
## amnesic-live system has no overlay boot area to maintain).
live_mode_output="$("${helper_scripts_path}/usr/libexec/helper-scripts/live-mode.sh" 2>/dev/null)" || true
if ! grep --quiet --line-regexp "live_status_persistence_active='true'" \
   <<< "${live_mode_output}"; then
   exit 0
fi

if [ -z "${kernel_version}" ]; then
   printf '%s\n' "live-persistence boot sync: no kernel version argument; skipping." >&2
   exit 0
fi

if sync_boot_area; then
   printf '%s\n' "live-persistence boot sync: kernel ${kernel_version} synced to the persistent boot area." >&2
else
   printf '%s\n' "WARNING: live-persistence boot sync FAILED for kernel ${kernel_version}." >&2
   printf '%s\n' "The upgraded kernel may not boot persistent until the boot area is re-synced." >&2
fi
exit 0
